# happycodex 运行时配置模板。
# 用法：cp .env.example .env 后按本机情况填值。
# .env 已被 .gitignore 忽略，绝不入库（含端口/域名/密钥等部署私有值）。
# 加载时机：src/load-env.ts 在 index.ts 首行 process.loadEnvFile()，早于 config.ts/web.ts 求值。
# 所有键都有代码内默认值，整份留空也能跑（单机 localhost 开发）。

# ── Web 服务 ──────────────────────────────────────────────
# 监听端口（默认 3000）。同机与 happyclaw 并存时改 3100 等避让。
WEB_PORT=3000
# 助手显示名（默认 HappyClaw）。
# ASSISTANT_NAME=HappyCodex

# ── 公网部署（反代/隧道后必填）────────────────────────────
# 允许的浏览器 Origin 白名单（逗号分隔），同时把关 /api CORS 与 /ws 升级。
# 公网域名缺它则 WebSocket 被 CSWSH 防护 403（src/web.ts:972）。'*' 放行全部（不建议）。
# CORS_ALLOWED_ORIGINS=https://happycodex.example.com
# 是否额外放行任意端口的 localhost/127.0.0.1（默认 true；设 false 收紧）。
# CORS_ALLOW_LOCALHOST=true
# 处于反代/Cloudflare 隧道后时设 true，从 X-Forwarded-For 取真实客户端 IP。
# TRUST_PROXY=true

# ── 安全 ──────────────────────────────────────────────────
# 会话 cookie 签名密钥（HMAC）。留空则自动生成并持久化到 data/config/session-secret.key。
# 多实例共享会话时需显式设同一值。
# WEB_SESSION_SECRET=

# ── codex 认证 ────────────────────────────────────────────
# per-user 缺自登凭据时是否回退共享账号（默认 true）。设 false 强制各用户自登。
# HAPPYCODEX_PERUSER_AUTH_FALLBACK=true
# 覆盖共享 CODEX_HOME 位置（默认 ~/.codex）。
# HAPPYCODEX_SHARED_CODEX_HOME=

# ── 其它 ──────────────────────────────────────────────────
# 定时任务时区（默认取系统，再回退 Asia/Shanghai）。
# TZ=Asia/Shanghai
# 容器镜像名（默认 happycodex-agent:latest）。
# CONTAINER_IMAGE=happycodex-agent:latest
