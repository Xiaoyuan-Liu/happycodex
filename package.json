{
  "name": "happycodex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codex 版 HappyClaw — 基于 codex app-server 的多用户 Agent 运行时（Stage 0–2: PoC + 流式映射 + 注入循环）",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/agent-runner.js",
    "dev": "tsx src/agent-runner.ts",
    "poc:entry": "tsx src/poc/poc-entry.ts",
    "poc:stream": "tsx src/poc/poc-stream.ts",
    "poc:steer": "tsx src/poc/poc-steer.ts",
    "poc:resume": "tsx src/poc/poc-resume.ts",
    "poc:tools": "tsx src/poc/poc-tools.ts",
    "poc:multitenant": "tsx src/poc/poc-multitenant.ts",
    "poc:subagent": "tsx src/poc/poc-subagent.ts",
    "poc:compact": "tsx src/poc/poc-compact.ts",
    "poc:hooks": "tsx src/poc/poc-hooks.ts",
    "protocol:regen": "codex app-server generate-ts --experimental --out protocol/ts && codex app-server generate-json-schema --experimental --out protocol/schema"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.19",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.58.0",
    "better-sqlite3": "^11.10.0",
    "dingtalk-stream": "2.1.6-beta.1",
    "discord.js": "^14.26.2",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "ws": "^8.19.0",
    "zod": "^4.4.3"
  }
}
